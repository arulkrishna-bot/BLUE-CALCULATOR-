name: Build Perfect Calculator V4
on:
  workflow_dispatch:
  push:
    branches: ["main"]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.19.0'
          channel: 'stable'

      - name: Create Flutter Project
        run: |
          flutter create exact_calc
          cd exact_calc
          flutter pub add math_expressions
          flutter pub add intl

      - name: Write Main Code (Live Calc & 15 Converters)
        run: |
          cd exact_calc
          cat << 'EOF' > lib/main.dart
          import 'package:flutter/material.dart';
          import 'dart:async';
          import 'package:math_expressions/math_expressions.dart';
          import 'package:intl/intl.dart';
          import 'package:intl/date_symbol_data_local.dart';

          Future<void> main() async {
            WidgetsFlutterBinding.ensureInitialized();
            await initializeDateFormatting('ta_IN', null);
            runApp(const ExactCalcApp());
          }

          class ExactCalcApp extends StatelessWidget {
            const ExactCalcApp({super.key});
            @override
            Widget build(BuildContext context) {
              return MaterialApp(
                title: 'Calculator',
                debugShowCheckedModeBanner: false,
                themeMode: ThemeMode.dark,
                darkTheme: ThemeData(
                  brightness: Brightness.dark,
                  scaffoldBackgroundColor: const Color(0xFF16181B), // Exact matching dark background
                  fontFamily: 'Roboto',
                ),
                home: const MainScreen(),
              );
            }
          }

          class MainScreen extends StatefulWidget {
            const MainScreen({super.key});
            @override
            State<MainScreen> createState() => _MainScreenState();
          }

          class _MainScreenState extends State<MainScreen> with SingleTickerProviderStateMixin {
            late TabController _tabController;
            String _timeString = "";
            String _dateString = "";

            @override
            void initState() {
              super.initState();
              _tabController = TabController(length: 2, vsync: this);
              _updateTime();
              Timer.periodic(const Duration(seconds: 1), (Timer t) => _updateTime());
            }

            void _updateTime() {
              final now = DateTime.now();
              if(mounted) {
                setState(() {
                  _timeString = DateFormat('hh:mm a', 'ta_IN').format(now);
                  _dateString = DateFormat('dd MMMM, EEEE', 'ta_IN').format(now);
                });
              }
            }

            @override
            Widget build(BuildContext context) {
              return Scaffold(
                backgroundColor: const Color(0xFF16181B),
                body: SafeArea(
                  child: Column(
                    children: [
                      Padding(
                        padding: const EdgeInsets.symmetric(horizontal: 24, vertical: 12),
                        child: Row(
                          mainAxisAlignment: MainAxisAlignment.spaceBetween,
                          children: [
                            Text(_dateString, style: const TextStyle(color: Colors.white54, fontSize: 13, letterSpacing: 0.5)),
                            Text(_timeString, style: const TextStyle(color: Colors.white54, fontSize: 13, letterSpacing: 0.5)),
                          ],
                        ),
                      ),
                      Container(
                        margin: const EdgeInsets.symmetric(horizontal: 60, vertical: 10),
                        height: 45,
                        decoration: BoxDecoration(
                          color: const Color(0xFF23252A),
                          borderRadius: BorderRadius.circular(25),
                        ),
                        child: TabBar(
                          controller: _tabController,
                          indicator: BoxDecoration(
                            borderRadius: BorderRadius.circular(25),
                            color: const Color(0xFF2979FF), // Exact Blue
                          ),
                          labelColor: Colors.white,
                          unselectedLabelColor: Colors.white54,
                          labelStyle: const TextStyle(fontSize: 12, fontWeight: FontWeight.bold, letterSpacing: 1),
                          tabs: const [Tab(text: "CALCULATOR"), Tab(text: "CONVERTER")],
                        ),
                      ),
                      Expanded(
                        child: TabBarView(
                          controller: _tabController,
                          children: [
                            const CalculatorUI(),
                            const ConverterUI(),
                          ],
                        ),
                      ),
                    ],
                  ),
                ),
              );
            }
          }

          // ================= CALCULATOR =================
          class CalculatorUI extends StatefulWidget {
            const CalculatorUI({super.key});
            @override
            State<CalculatorUI> createState() => _CalculatorUIState();
          }

          class _CalculatorUIState extends State<CalculatorUI> {
            String equation = "";
            String result = "0";

            void calculateLive() {
              try {
                String finalEq = equation.replaceAll('×', '*').replaceAll('÷', '/').replaceAll('−', '-');
                if(finalEq.isEmpty) {
                  result = "0";
                  return;
                }
                // Don't try to calculate if it ends with an operator
                if (finalEq.endsWith('+') || finalEq.endsWith('-') || finalEq.endsWith('*') || finalEq.endsWith('/') || finalEq.endsWith('.')) {
                  return;
                }
                double eval = Parser().parse(finalEq).evaluate(EvaluationType.REAL, ContextModel());
                result = eval.toStringAsFixed(eval.truncateToDouble() == eval ? 0 : 4);
              } catch (e) {
                // Keep the last valid result
              }
            }

            void buttonPressed(String buttonText) {
              setState(() {
                if (buttonText == "AC") {
                  equation = "";
                  result = "0";
                } else if (buttonText == "⌫") {
                  if (equation.isNotEmpty) {
                    equation = equation.substring(0, equation.length - 1);
                    calculateLive();
                  }
                  if (equation.isEmpty) result = "0";
                } else if (buttonText == "=") {
                  // Optional: User presses =, equation becomes the result
                  if (result != "0" && result != "Error") {
                    equation = result;
                    result = "";
                  }
                } else {
                  equation = equation + buttonText;
                  calculateLive(); // Calculate automatically as you type
                }
              });
            }

            Widget calcButton(String text, Color textColor, Color bgColor, {bool isWide = false}) {
              return Expanded(
                flex: isWide ? 2 : 1,
                child: Padding(
                  padding: const EdgeInsets.all(7.0), // Perfect spacing like in the photo
                  child: Material(
                    color: bgColor,
                    borderRadius: BorderRadius.circular(22), // More rounded like the photo
                    child: InkWell(
                      onTap: () => buttonPressed(text),
                      borderRadius: BorderRadius.circular(22),
                      splashColor: Colors.white24,
                      child: Center(
                        child: Text(
                          text,
                          style: TextStyle(fontSize: 28, color: textColor, fontWeight: FontWeight.w400),
                        ),
                      ),
                    ),
                  ),
                ),
              );
            }

            @override
            Widget build(BuildContext context) {
              return Column(
                children: [
                  Expanded(
                    flex: 3,
                    child: Container(
                      padding: const EdgeInsets.symmetric(horizontal: 30, vertical: 20),
                      alignment: Alignment.bottomRight,
                      child: Column(
                        mainAxisAlignment: MainAxisAlignment.end,
                        crossAxisAlignment: CrossAxisAlignment.end,
                        children: [
                          Text(equation.isEmpty ? "" : equation, style: const TextStyle(fontSize: 34, color: Colors.white54)),
                          const SizedBox(height: 10),
                          Text(result.isEmpty ? "" : "=$result", style: const TextStyle(fontSize: 56, color: Colors.white, fontWeight: FontWeight.bold)),
                        ],
                      ),
                    ),
                  ),
                  const Padding(
                    padding: EdgeInsets.only(bottom: 20),
                    child: Text(
                      "சரியான கணக்கீடு\nசிறப்பான முடிவு தரும்...",
                      textAlign: TextAlign.center,
                      style: TextStyle(color: Color(0xFF2979FF), fontSize: 13, height: 1.5),
                    ),
                  ),
                  Expanded(
                    flex: 6,
                    child: Container(
                      padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
                      child: Column(
                        children: [
                          Expanded(child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
                            calcButton("AC", const Color(0xFFEF5350), const Color(0xFF23252A)),
                            calcButton("⌫", Colors.white70, const Color(0xFF23252A)),
                            calcButton("%", Colors.white70, const Color(0xFF23252A)),
                            calcButton("÷", Colors.white, const Color(0xFF2979FF)),
                          ])),
                          Expanded(child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
                            calcButton("7", Colors.white, const Color(0xFF23252A)),
                            calcButton("8", Colors.white, const Color(0xFF23252A)),
                            calcButton("9", Colors.white, const Color(0xFF23252A)),
                            calcButton("×", Colors.white, const Color(0xFF2979FF)),
                          ])),
                          Expanded(child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
                            calcButton("4", Colors.white, const Color(0xFF23252A)),
                            calcButton("5", Colors.white, const Color(0xFF23252A)),
                            calcButton("6", Colors.white, const Color(0xFF23252A)),
                            calcButton("−", Colors.white, const Color(0xFF2979FF)),
                          ])),
                          Expanded(child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
                            calcButton("1", Colors.white, const Color(0xFF23252A)),
                            calcButton("2", Colors.white, const Color(0xFF23252A)),
                            calcButton("3", Colors.white, const Color(0xFF23252A)),
                            calcButton("+", Colors.white, const Color(0xFF2979FF)),
                          ])),
                          Expanded(child: Row(crossAxisAlignment: CrossAxisAlignment.stretch, children: [
                            calcButton("0", Colors.white, const Color(0xFF23252A), isWide: true),
                            calcButton(".", Colors.white, const Color(0xFF23252A)),
                            calcButton("=", Colors.white, const Color(0xFF2979FF)),
                          ])),
                        ],
                      ),
                    ),
                  ),
                ],
              );
            }
          }

          // ================= CONVERTER (15 ITEMS) =================
          class ConverterUI extends StatelessWidget {
            const ConverterUI({super.key});

            final List<Map<String, dynamic>> categories = const [
              {"name": "Currency", "icon": Icons.attach_money},
              {"name": "Length", "icon": Icons.straighten},
              {"name": "Mass", "icon": Icons.monitor_weight},
              {"name": "Area", "icon": Icons.grid_on},
              {"name": "Time", "icon": Icons.access_time},
              {"name": "Finance", "icon": Icons.account_balance},
              {"name": "Data", "icon": Icons.sd_storage},
              {"name": "Date", "icon": Icons.calendar_today},
              {"name": "Discount", "icon": Icons.local_offer},
              {"name": "Volume", "icon": Icons.view_in_ar},
              {"name": "Numeral", "icon": Icons.format_list_numbered},
              {"name": "Speed", "icon": Icons.speed},
              {"name": "Temperature", "icon": Icons.thermostat},
              {"name": "GST", "icon": Icons.receipt_long},
              {"name": "BMI", "icon": Icons.accessibility_new},
            ];

            void openConverter(BuildContext context, String category) {
              showModalBottomSheet(
                context: context,
                isScrollControlled: true,
                backgroundColor: Colors.transparent,
                builder: (context) => ActiveConverterSheet(category: category),
              );
            }

            @override
            Widget build(BuildContext context) {
              return Container(
                padding: const EdgeInsets.symmetric(horizontal: 20, vertical: 20),
                child: GridView.builder(
                  itemCount: categories.length,
                  gridDelegate: const SliverGridDelegateWithFixedCrossAxisCount(
                    crossAxisCount: 3, crossAxisSpacing: 15, mainAxisSpacing: 15, childAspectRatio: 1.0,
                  ),
                  itemBuilder: (context, index) {
                    return Material(
                      color: const Color(0xFF23252A),
                      borderRadius: BorderRadius.circular(20),
                      child: InkWell(
                        onTap: () => openConverter(context, categories[index]["name"]),
                        borderRadius: BorderRadius.circular(20),
                        splashColor: const Color(0xFF2979FF).withOpacity(0.3),
                        child: Column(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            Icon(categories[index]["icon"], color: const Color(0xFF2979FF), size: 30),
                            const SizedBox(height: 10),
                            Text(categories[index]["name"], style: const TextStyle(color: Colors.white70, fontSize: 11)),
                          ],
                        ),
                      ),
                    );
                  },
                ),
              );
            }
          }

          class ActiveConverterSheet extends StatefulWidget {
            final String category;
            const ActiveConverterSheet({super.key, required this.category});
            @override
            State<ActiveConverterSheet> createState() => _ActiveConverterSheetState();
          }

          class _ActiveConverterSheetState extends State<ActiveConverterSheet> {
            String fromUnit = "";
            String toUnit = "";
            TextEditingController inputController = TextEditingController(text: "1");
            String result = "";

            final Map<String, List<String>> unitMap = {
              "Length": ["Meter", "Kilometer", "Centimeter", "Millimeter", "Mile", "Foot"],
              "Mass": ["Kilogram", "Gram", "Milligram", "Pound"],
              "Time": ["Second", "Minute", "Hour", "Day"],
              "Temperature": ["Celsius", "Fahrenheit", "Kelvin"],
              "Area": ["Sq Meter", "Sq Kilometer", "Acre", "Hectare"],
              "Volume": ["Liter", "Milliliter", "Cubic Meter"],
              "Speed": ["m/s", "km/h", "mph"],
              "Data": ["Byte", "KB", "MB", "GB", "TB"],
            };

            final Map<String, double> rates = {
              "Meter": 1, "Kilometer": 1000, "Centimeter": 0.01, "Millimeter": 0.001, "Mile": 1609.34, "Foot": 0.3048,
              "Kilogram": 1000, "Gram": 1, "Milligram": 0.001, "Pound": 453.592,
              "Second": 1, "Minute": 60, "Hour": 3600, "Day": 86400,
              "Sq Meter": 1, "Sq Kilometer": 1000000, "Acre": 4046.86, "Hectare": 10000,
              "Liter": 1, "Milliliter": 0.001, "Cubic Meter": 1000,
              "m/s": 1, "km/h": 0.277778, "mph": 0.44704,
              "Byte": 1, "KB": 1024, "MB": 1048576, "GB": 1073741824, "TB": 1099511627776,
            };

            @override
            void initState() {
              super.initState();
              if (unitMap.containsKey(widget.category)) {
                fromUnit = unitMap[widget.category]![0];
                toUnit = unitMap[widget.category]![1];
                calculate();
              }
            }

            void calculate() {
              double input = double.tryParse(inputController.text) ?? 0;
              double out = 0;
              if (widget.category == "Temperature") {
                if (fromUnit == "Celsius" && toUnit == "Fahrenheit") out = (input * 9/5) + 32;
                else if (fromUnit == "Fahrenheit" && toUnit == "Celsius") out = (input - 32) * 5/9;
                else if (fromUnit == "Celsius" && toUnit == "Kelvin") out = input + 273.15;
                else if (fromUnit == "Kelvin" && toUnit == "Celsius") out = input - 273.15;
                else out = input;
              } else {
                double base = input * rates[fromUnit]!;
                out = base / rates[toUnit]!;
              }
              setState(() {
                result = out.toStringAsFixed(out.truncateToDouble() == out ? 0 : 4);
              });
            }

            @override
            Widget build(BuildContext context) {
              bool isSupported = unitMap.containsKey(widget.category);
              
              return Container(
                height: MediaQuery.of(context).size.height * 0.65,
                padding: const EdgeInsets.all(24),
                decoration: const BoxDecoration(
                  color: Color(0xFF16181B),
                  borderRadius: BorderRadius.only(topLeft: Radius.circular(30), topRight: Radius.circular(30)),
                  border: Border(top: BorderSide(color: Colors.white12)),
                ),
                child: isSupported ? Column(
                  children: [
                    Text("${widget.category} Converter", style: const TextStyle(fontSize: 20, color: Colors.white, fontWeight: FontWeight.bold)),
                    const SizedBox(height: 30),
                    TextField(
                      controller: inputController,
                      keyboardType: TextInputType.number,
                      style: const TextStyle(fontSize: 24, color: Colors.white),
                      textAlign: TextAlign.center,
                      decoration: InputDecoration(
                        filled: true,
                        fillColor: const Color(0xFF23252A),
                        border: OutlineInputBorder(borderRadius: BorderRadius.circular(15), borderSide: BorderSide.none),
                      ),
                      onChanged: (v) => calculate(),
                    ),
                    const SizedBox(height: 20),
                    Row(
                      mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                      children: [
                        DropdownButton<String>(
                          value: fromUnit,
                          dropdownColor: const Color(0xFF23252A),
                          style: const TextStyle(color: Colors.white, fontSize: 16),
                          items: unitMap[widget.category]!.map((u) => DropdownMenuItem(value: u, child: Text(u))).toList(),
                          onChanged: (v) { setState(() { fromUnit = v!; calculate(); }); },
                        ),
                        const Icon(Icons.arrow_forward, color: Color(0xFF2979FF)),
                        DropdownButton<String>(
                          value: toUnit,
                          dropdownColor: const Color(0xFF23252A),
                          style: const TextStyle(color: Colors.white, fontSize: 16),
                          items: unitMap[widget.category]!.map((u) => DropdownMenuItem(value: u, child: Text(u))).toList(),
                          onChanged: (v) { setState(() { toUnit = v!; calculate(); }); },
                        ),
                      ],
                    ),
                    const Spacer(),
                    Container(
                      width: double.infinity,
                      padding: const EdgeInsets.all(20),
                      decoration: BoxDecoration(color: const Color(0xFF2979FF).withOpacity(0.15), borderRadius: BorderRadius.circular(20)),
                      child: Text("= $result", textAlign: TextAlign.center, style: const TextStyle(fontSize: 32, fontWeight: FontWeight.bold, color: Color(0xFF2979FF))),
                    ),
                    const SizedBox(height: 20),
                  ],
                ) : Center(child: Text("விரைவில் வரும்: ${widget.category}", style: const TextStyle(color: Colors.white54, fontSize: 18))),
              );
            }
          }
          EOF

      - name: Build Final APK
        run: |
          cd exact_calc
          flutter clean
          flutter pub get
          flutter build apk --release

      - name: Upload Exact Match APK
        uses: actions/upload-artifact@v4
        with:
          name: Final-App-V4
          path: exact_calc/build/app/outputs/flutter-apk/app-release.apk
          if-no-files-found: error
